{
    "multipart": [
        {
            "apply": {
                "model": "buildcraft:block/pipe_fluid_cobblestone_center"
            }
        },
        {
            "when": {
                "up": "true"
            },
            "apply": {
                "model": "buildcraft:block/pipe_fluid_cobblestone_arm"
            }
        },
        {
            "when": {
                "down": "true"
            },
            "apply": {
                "model": "buildcraft:block/pipe_fluid_cobblestone_arm",
                "x": 180
            }
        },
        {
            "when": {
                "south": "true"
            },
            "apply": {
                "model": "buildcraft:block/pipe_fluid_cobblestone_arm",
                "x": 90
            }
        },
        {
            "when": {
                "west": "true"
            },
            "apply": {
                "model": "buildcraft:block/pipe_fluid_cobblestone_arm",
                "x": 90,
                "y": 90
            }
        },
        {
            "when": {
                "north": "true"
            },
            "apply": {
                "model": "buildcraft:block/pipe_fluid_cobblestone_arm",
                "x": 90,
                "y": 180
            }
        },
        {
            "when": {
                "east": "true"
            },
            "apply": {
                "model": "buildcraft:block/pipe_fluid_cobblestone_arm",
                "x": 90,
                "y": 270
            }
        }
    ]
}